
# macOS
.DS_Store
**/.DS_Store

# Website moved to separate repository
development/websitev2/

# Canonical env location (per-machine, never committed)
.config/

# Worktree directories — git worktrees at bare root, not regular subdirs.
# Suppresses untracked-file noise for the long-lived worktrees and any
# /b-work-created feature worktree ([type-prefix]-[id]/, e.g. infra-142/).
development/
main/
[a-z]*-[0-9]*/
# The gate worktree (INFRA-436) is named, not numbered, so it does NOT match the
# pattern above — without this line it shows as a plain untracked directory and the
# next `git add .` in this shared tree commits a ~600 MB worktree.
e2e-gate/

# Process artifacts (per-machine, never committed)
.claude/scheduled_tasks.lock

# Working scratchpad from /m:audit runs (not for version history;
# move to docs/audits/ if a snapshot is worth preserving)
.audit-report.md
