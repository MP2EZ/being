{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_description": "Being. App - Clinical Grade TypeScript Configuration",
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "composite": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    // MAINT-162 (TS 5.9 → 6.0): under TS 6 the automatic inclusion of ambient
    // `@types` stopped pulling in `@types/node`, so `NodeJS.Timeout` / `global`
    // failed to resolve across the codebase. Pin the ambient type packages
    // explicitly. (`@types/react` also flows in via module imports; listed here
    // to preserve its UMD global. Test-only `@types/jest` is unneeded — test
    // files are excluded below.)
    "types": ["node", "react"],
    // TS 6 deprecates `baseUrl` (removed in TS 7). Kept for now — its clean
    // removal belongs to the deferred TS 7 migration. Silence the TS6.0
    // deprecation-as-error via `ignoreDeprecations` until then.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Feature-based aliases. Subsumed by the `@/*` catch-all above — they are
      // kept because they read better at call sites, not because removal would
      // change resolution.
      //
      // This block is Metro's LIVE alias table, not just tsc's: Expo CLI passes
      // these `paths` to the bundler via its `tsconfigPaths` experiment, which
      // defaults on and is not disabled in app.json. metro.config.js does NOT
      // supply aliases — see the note there.
      //
      // MAINT-623 removed nine entries (@/analytics, @/components, @/screens,
      // @/services, @/store, @/types, @/utils, @/api, @/validation). Every
      // target directory had been deleted in the 688ffd1 reorganization and
      // none had an importer.
      "@/core/*": ["src/core/*"],
      "@/features/*": ["src/features/*"]
    }
  },
  "include": [
    "src/**/*",
    "index.ts",
    "App.tsx",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "src/mocks/reanimated-temp.ts",
    "coverage",
    "dist",
    "build",
    ".expo",
    ".tsbuildinfo"
  ]
}
