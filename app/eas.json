{
  "cli": {
    "version": ">= 12.14.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "BUILD_TYPE": "development",
        "CLINICAL_VALIDATION": "true",
        "NEW_ARCHITECTURE": "true"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "BUILD_TYPE": "preview",
        "CLINICAL_VALIDATION": "true",
        "WELLNESS_MONITORING_ENABLED": "true",
        "PERFORMANCE_MONITORING": "true",
        "NEW_ARCHITECTURE": "true",
        "CRISIS_MONITORING": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "$SUPABASE_URL_STAGING"
      },
      "cache": {
        "disabled": false
      }
    },
    "production": {
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      },
      "env": {
        "BUILD_TYPE": "production",
        "CLINICAL_VALIDATION": "true",
        "WELLNESS_MONITORING_ENABLED": "true",
        "PERFORMANCE_MONITORING": "true",
        "NEW_ARCHITECTURE": "true",
        "CRISIS_MONITORING": "true",
        "PRODUCTION_MONITORING": "true",
        "WELLNESS_DATA_PROTECTION": "true",
        "WELLNESS_PRACTICES_MONITORING": "true"
      },
      "cache": {
        "disabled": false,
        "paths": [
          "app/node_modules"
        ]
      }
    },
    "e2e-sim": {
      "extends": "production",
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_E2E_SEED_ONBOARDED": "true",
        "EXPO_PUBLIC_FEATURE_FLAGS": "cloud_sync:false,emergency_sync:false,cross_device_sync:false,wellness_trend_notes:false,data_export:false,bug_reporting:true"
      }
    },
    "production-emergency": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "BUILD_TYPE": "production",
        "EMERGENCY_DEPLOYMENT": "true",
        "CRISIS_OVERRIDE": "true",
        "WELLNESS_MONITORING_ENABLED": "true",
        "PERFORMANCE_MONITORING": "true",
        "NEW_ARCHITECTURE": "true",
        "PRODUCTION_MONITORING": "true",
        "WELLNESS_DATA_PROTECTION": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6777579207",
        "appleTeamId": "KN6FDLG98K"
      },
      "android": {
        "serviceAccountKeyPath": "./android-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6777579207",
        "appleTeamId": "KN6FDLG98K"
      },
      "android": {
        "serviceAccountKeyPath": "./android-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
