{
  "expo": {
    "name": "Being",
    "slug": "being",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Evidence-based Stoic Mindfulness practices for mental wellness and virtue development.",
    "primaryColor": "#4A7C59",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "being",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fyi.being.app",
      "buildNumber": "3",
      "icon": "./assets/icon.png",
      "deploymentTarget": "16.4",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "sms"
        ],
        "NSFaceIDUsageDescription": "Allow Being to use Face ID to protect your wellness data."
      },
      "associatedDomains": [
        "applinks:being.fyi",
        "applinks:www.being.fyi"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "fyi.being.app",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "being.fyi",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.being.fyi",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Being",
      "shortName": "Being"
    },
    "plugins": [
      "expo-localization",
      "expo-notifications",
      [
        "./plugins/withAppGroupsEntitlement",
        {
          "groups": [
            "group.fyi.being.app.widgets"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Being uses the microphone only to turn a spoken reflection into text on this device. The recording is discarded once transcribed and never leaves your phone.",
          "speechRecognitionPermission": "Being transcribes spoken reflections entirely on this device. Nothing you say is sent to Apple or to Being."
        }
      ]
    ],
    "extra": {
      "clinicalVersion": "1.0",
      "buildType": "production",
      "eas": {
        "projectId": "8229e873-3c06-41fc-a8cf-48a45fa76316"
      }
    },
    "owner": "palouselabs"
  }
}
