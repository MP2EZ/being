{
  "name": "app",
  "version": "1.1.0",
  "main": "index.ts",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "generate:legal-content": "node scripts/generate-legal-content.js",
    "prestart": "npm run generate:legal-content",
    "preios": "npm run generate:legal-content",
    "preandroid": "npm run generate:legal-content",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "test:ci": "jest --coverage --ci --watchAll=false --forceExit",
    "test:clinical": "jest --testPathPattern=clinical --verbose --forceExit",
    "test:crisis-detection": "jest --testPathPattern=\"(crisis-safety-automation|crisis-intervention-safety|crisis-thresholds|offline-crisis-management|CollapsibleCrisisButton.behavioral|CrisisSecurityProtocol|textCrisisDetection)\" --verbose --testTimeout=30000 --forceExit",
    "test:unit": "jest --testPathPattern=unit --forceExit",
    "test:safety": "jest --testPathPattern=\"(__tests__/safety|__tests__/crisis-safety)\" --verbose --forceExit",
    "test:edge-functions": "cd ../supabase/functions && deno task test",
    "test:integration": "jest --testPathPattern=integration --verbose --forceExit",
    "test:performance": "jest --testPathPattern=performance --verbose --forceExit",
    "test:accessibility": "jest --testPathPattern=accessibility --verbose --forceExit",
    "test:security": "jest --testPathPattern=security --verbose --forceExit --detectOpenHandles",
    "test:privacy": "jest --testPathPattern=privacy --verbose --forceExit",
    "test:scripts": "jest --testPathPattern=__tests__/scripts --verbose --forceExit",
    "test:practices": "jest --testPathPattern=src/features/practices --verbose --forceExit",
    "test:encryption": "jest --testPathPattern=EncryptionService --verbose",
    "test:crisis-quick": "jest --testPathPattern=\"[Cc]risis\" --ci --silent --testTimeout=5000 --maxWorkers=4",
    "test:clinical-quick": "JEST_QUICK=true jest --testNamePattern=\"clinical|phq|gad\"",
    "test:offline": "jest --testPathPattern=offline --verbose --testTimeout=60000",
    "test:offline-crisis": "jest --testPathPattern=\"offline-crisis\" --testNamePattern=\"Offline Crisis Management\" --verbose --testTimeout=30000",
    "validate:clinical": "npm run test:clinical && echo '\u2705 Clinical accuracy tests passed'",
    "validate:accessibility": "npm run test:accessibility && echo '\u2705 Accessibility tests passed'",
    "validate:performance": "npm run test:performance && echo '\u2705 Performance tests passed'",
    "validate:clinical-complete": "npm run test:clinical && echo '\u2705 Complete clinical accuracy validation passed'",
    "validate:crisis-authority": "npm run test:crisis-quick && echo '\u2705 Crisis Authority validation passed'",
    "validate:compliance-authority": "npm run test:encryption && echo '\u2705 Compliance Authority validation passed'",
    "validate:clinical-authority": "npm run validate:clinical-complete && echo '\u2705 Clinical Authority validation passed'",
    "validate:offline-crisis": "npm run test:offline-crisis && echo '\u2705 Offline crisis management validation passed'",
    "local:crisis-check": "npm run test:crisis-quick && echo '\u2705 Crisis safety validation complete'",
    "local:clinical-check": "npm run test:clinical && npm run validate:clinical-complete && echo '\u2705 Clinical accuracy validation complete'",
    "reports:dashboard": "node scripts/test-report-generator.js dashboard",
    "reports:performance": "node scripts/test-report-generator.js performance",
    "reports:coverage": "node scripts/test-report-generator.js coverage",
    "reports:all": "node scripts/test-report-generator.js all",
    "quick:validate": "node scripts/quick-validation.js smart",
    "quick:crisis": "node scripts/quick-validation.js crisis",
    "quick:clinical": "node scripts/quick-validation.js clinical",
    "quick:syntax": "node scripts/quick-validation.js syntax",
    "quick:perf": "node scripts/quick-validation.js performance",
    "quick:fix": "node scripts/quick-validation.js fix",
    "quick:watch": "node scripts/quick-validation.js watch",
    "quick:interactive": "node scripts/quick-validation.js interactive",
    "dev:test-smart": "node scripts/dev-test-runner.js smart",
    "dev:test-focused": "node scripts/dev-test-runner.js focused",
    "dev:test-debug": "node scripts/dev-test-runner.js debug",
    "dev:test-fast": "node scripts/dev-test-runner.js fast",
    "dev:test-coverage": "node scripts/dev-test-runner.js coverage",
    "platform:list": "node scripts/cross-platform-testing.js list",
    "platform:ios": "node scripts/cross-platform-testing.js ios",
    "platform:android": "node scripts/cross-platform-testing.js android",
    "platform:both": "node scripts/cross-platform-testing.js both",
    "platform:setup": "node scripts/cross-platform-testing.js setup",
    "platform:parallel": "node scripts/cross-platform-testing.js both --parallel",
    "lint": "eslint src --ext .ts,.tsx",
    "check:safe-area-imports": "node scripts/check-safe-area-imports.js",
    "lint:baseline": "node scripts/lint-baseline.js",
    "lint:clinical": "eslint --max-warnings=0 src/core/analytics/PostHogProvider.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "npx tsc --noEmit --incremental",
    "precommit": "npm run typecheck && npm run lint:baseline && npm run test:safety && npm run test:clinical && npm run test:unit && npm run test:privacy",
    "check:crisis-hotline": "node scripts/check-crisis-hotline.js",
    "check:breathing-worklets": "node scripts/check-breathing-worklet-purity.js",
    "check:ci-test-coverage": "node scripts/check-ci-test-coverage.js",
    "check:workflow-scripts": "node scripts/check-workflow-scripts.js",
    "check:crisis-dial": "node scripts/check-crisis-dial-guard.js",
    "check:modal-occlusion": "node scripts/check-modal-occlusion-guard.js",
    "check:crisis-keyboard-accessory": "node scripts/check-crisis-keyboard-accessory-guard.js",
    "prepare": "[ ! -e ../.git ] && exit 0; cd .. && husky app/.husky",
    "postinstall": "patch-package && node scripts/generate-legal-content.js",
    "prepush": "npm run check:crisis-hotline && npm run check:workflow-scripts",
    "version-check": "node -e \"const pkg=require('./package.json'); if(pkg.dependencies.react !== '19.2.3') throw new Error('React must be 19.2.3 for RN 0.85.x compatibility')\"",
    "security:sast": "echo \"\ud83d\udd0d Running SAST Analysis...\" && audit-ci --config .audit-ci.json && echo \"\u2705 SAST Analysis completed\"",
    "security:deps": "npm audit --audit-level high",
    "security:full": "npm run security:sast && npm run security:deps",
    "deploy:validate-rollback": "echo \"\ud83d\udd04 Validating rollback safety...\" && node -e \"console.log('Rollback validation would run here in production')\"",
    "e2e:safety": "bash scripts/e2e-safety.sh",
    "e2e:safety:build": "bash scripts/e2e-sim-build.sh",
    "e2e:safety:build:eas": "bash scripts/e2e-sim-build-eas.sh",
    "e2e:safety:gate": "bash scripts/e2e-gate.sh",
    "e2e:safety:clean": "bash scripts/e2e-sim-clean.sh",
    "e2e:safety:clean:orphans": "bash scripts/e2e-sim-clean.sh --orphans",
    "e2e:safety:q9": "bash scripts/e2e-safety.sh q9-single-alert",
    "e2e:safety:phq9": "bash scripts/e2e-safety.sh phq9-severe-completion",
    "e2e:safety:gad7": "bash scripts/e2e-safety.sh gad7-severe",
    "e2e:safety:crisis-button": "bash scripts/e2e-safety.sh crisis-button-reachability",
    "e2e:safety:art9-optional": "bash scripts/e2e-safety.sh legal-gate-art9-optional",
    "e2e:safety:988-dial": "bash scripts/e2e-safety.sh crisis-988-dial",
    "e2e:safety:keyboard-accessory": "bash scripts/e2e-safety.sh crisis-keyboard-accessory",
    "e2e:safety:journal": "bash scripts/e2e-safety.sh journal-crisis-scan",
    "e2e:safety:guidance": "bash scripts/e2e-safety.sh guidance-suppressed-handoff",
    "e2e:safety:consent-gate": "bash scripts/e2e-safety.sh deeplink-consent-gate",
    "e2e:safety:reconsent": "bash scripts/e2e-safety.sh reconsent-stale",
    "e2e:safety:reconsent-ineligible": "bash scripts/e2e-safety.sh reconsent-stale-ineligible",
    "e2e:safety:daily-loop": "bash scripts/e2e-safety.sh daily-loop-quick-depth",
    "e2e:safety:ax5": "bash scripts/e2e-dynamic-type.sh daily-loop-ax5-entry",
    "e2e:safety:xxxl": "E2E_DYNAMIC_TYPE_SIZE=extra-extra-extra-large bash scripts/e2e-dynamic-type.sh profile-voice-reflection-xxxl",
    "e2e:safety:telemetry": "bash -c '. scripts/e2e-telemetry.sh; e2e_telemetry_summary \"${1:-}\"' --",
    "close:detached": "bash scripts/b-close-run.sh",
    "close:status": "bash -c '. scripts/b-close-verdict.sh; b_close_status' --"
  },
  "overrides": {
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "@types/react": "19.2.14",
    "shell-quote": "^1.10.0",
